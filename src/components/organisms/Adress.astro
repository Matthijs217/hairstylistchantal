---
import { sanityClient } from '../../lib/sanity.js';

interface Openingstijd {
  dag: string;
  tijd: string;
}

const adres = {
  straat: 'Noordmeer 2',
  plaats: 'Broek in Waterland',
  mapsUrl: 'https://www.google.com/maps/dir/?api=1&destination=Noordmeer+2,+Broek+in+Waterland',
  embedUrl: 'https://maps.google.com/maps?q=Noordmeer+2,+Broek+in+Waterland,+Nederland&output=embed',
};

const fallback: Openingstijd[] = [
  { dag: 'Maandag',   tijd: 'Gesloten' },
  { dag: 'Dinsdag',   tijd: '09:00 – 18:00' },
  { dag: 'Woensdag',  tijd: '09:00 – 18:00' },
  { dag: 'Donderdag', tijd: '09:00 – 20:00' },
  { dag: 'Vrijdag',   tijd: '09:00 – 18:00' },
  { dag: 'Zaterdag',  tijd: '09:00 – 17:00' },
  { dag: 'Zondag',    tijd: 'Gesloten' },
];

const instellingen = await sanityClient.fetch<{ openingstijden: Openingstijd[] } | null>(`
  *[_type == "instellingen" && _id == "instellingen"][0] {
    openingstijden
  }
`);

const openingstijden: Openingstijd[] = instellingen?.openingstijden?.length
  ? instellingen.openingstijden
  : fallback;
---

<section class="adres">
  <div class="adres-content">

    <div class="adres-kaart">
      <iframe
        src={adres.embedUrl}
        title="Kaart van Chantal Hairstyling, Noordmeer 2 Broek in Waterland"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>

    <div class="adres-info">
      <p class="adres-label">— Bezoek</p>
      <h2 class="adres-straat">{adres.straat}, {adres.plaats}</h2>

      <dl class="openingstijden">
        {openingstijden.map(({ dag, tijd }) => (
          <>
            <dt>{dag}</dt>
            <dd class={tijd === 'Gesloten' ? 'gesloten' : ''}>{tijd}</dd>
          </>
        ))}
      </dl>

      <a href={adres.mapsUrl} class="btn-route" target="_blank" rel="noopener noreferrer">
        Route plannen
      </a>
    </div>

  </div>
</section>

<style>
  .adres {
    background-color: var(--color-secondary);
    padding-block: var(--space-24);
    padding-inline: var(--space-8);
  }

  .adres-content {
    max-width: var(--container-max-width);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;

    @media (min-width: 800px) {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }

  /* ── Kaart ── */
  .adres-kaart {
    position: relative;
    border: var(--border-width) dashed var(--color-border);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .adres-kaart iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: none;
  }

  .kaart-label {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
    font-size: var(--font-size-muted);
    font-style: italic;
    color: var(--color-text);
    background-color: rgba(255, 255, 255, 0.85);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--border-radius-sm);
  }

  /* ── Info ── */
  .adres-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .adres-label {
    font-size: var(--font-size-muted);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-tertiary);
  }

  .adres-straat {
    font-family: var(--font-tertiary);
    font-size: var(--font-size-heading-l);
    font-weight: var(--font-weight-regular);
    color: var(--color-title);
    line-height: 1.2;
  }

  /* ── Openingstijden ── */
  .openingstijden {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-6);
  }

  .openingstijden dt {
    font-size: var(--font-size-body);
    color: var(--color-text);
  }

  .openingstijden dd {
    font-size: var(--font-size-body);
    color: var(--color-title);
  }

  .openingstijden dd.gesloten {
    color: var(--color-tertiary);
  }

  /* ── Knop ── */
  .btn-route {
    font-size: var(--font-size-muted);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-white);
    background-color: var(--color-accent);
    padding: var(--space-4) var(--space-8);
    border-radius: 9999px;
    align-self: flex-start;
    transition: opacity 0.2s ease;

    align-self: stretch;
    text-align: center;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    @media (min-width: 800px) {
      align-self: flex-start;
      text-align: left;
    }
  }

  .btn-route:hover {
    opacity: 0.85;
  }
</style>
