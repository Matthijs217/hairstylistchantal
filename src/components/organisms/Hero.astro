---

---

<section class="hero">
  <div class="hero-content">
    <p class="hero-welkom">welkom bij ~</p>
    <h1 class="hero-title">Hairstylist Chantal</h1>
    <p class="hero-sub">Hairstyling · Broekinwaterland</p>
    <p class="hero-description">Een rustige, persoonlijke salon waar tijd is voor jouw haar én een goed gesprek.</p>

    <div class="hero-image">
      <img
        src="../../../src/assets/salon.webp"
        alt="Sfeerfoto van de salon"
        width="300"
        height="300"
      />
    </div>

    <div class="hero-actions">
      <a
        href="https://www.treatwell.nl/salon/hairstylist-chantal-oosterlaken/"
        class="btn-primary"
        data-treatwell-booking
        target="_blank"
        rel="noopener noreferrer"
      >Maak een afspraak</a>
      <a href="/diensten" class="btn-secondary">Bekijk diensten</a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    padding-block: var(--space-8);
    padding-inline: var(--space-8);
  }

  .hero-content {
    max-width: var(--container-max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  /* ── Welkom ── */
  .hero-welkom {
    font-family: var(--font-secondary);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--color-text);
    margin-bottom: calc(var(--space-2) * -1);
  }

  /* ── Titel ── */
  .hero-title {
    font-size: var(--font-size-heading-l);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-title);
    line-height: 1;
    @media (min-width: 640px) {
        font-size: var(--font-size-heading-xl);
    }
  }
   

  /* ── Sub ── */
  .hero-sub {
    font-size: var(--font-size-muted);
    font-weight: var(--font-weight-medium);
    letter-spacing: .5em;
    text-transform: uppercase;
    color: var(--color-title);
    opacity: 0.75;
    @media (min-width: 640px) {
        letter-spacing: 1em;
    }
  }

  /* ── Omschrijving ── */
  .hero-description {
    font-size: var(--font-size-body);
    font-family: var(--font-tertiary);
    font-style: italic;
    color: var(--color-text);
    max-width: 56ch;
    margin-block: var(--space-2);
  }

  /* ── Afbeelding ── */
  .hero-image {
    width: 100%;
    max-width: 1100px;
    margin-block: var(--space-4);
    border-radius: var(--border-radius-md);
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    display: block;
    object-fit: cover;
  }

  /* ── Knoppen (desktop) ── */
  .hero-actions {
    display: none;

    @media (min-width: 640px) {
      display: flex;
      flex-direction: row;
      width: auto;
      gap: var(--space-4);
      flex-wrap: wrap;
      justify-content: center;
      margin-top: var(--space-2);
    }
  }

  .btn-primary,
  .btn-secondary {
    font-size: var(--font-size-muted);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    padding: var(--space-4) var(--space-8);
    border-radius: 9999px;
    transition: opacity 0.2s ease;
    white-space: nowrap;
    text-align: center;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    @media (min-width: 640px) {
      text-align: left;
    }
  }

  .btn-primary {
    background-color: var(--color-accent);
    color: var(--color-white);
    border: 1px solid var(--color-accent);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-title);
    border: 1px solid var(--color-title);
  }

  .btn-primary:hover,
  .btn-secondary:hover {
    opacity: 0.75;
  }
</style>

