---
import { sanityClient, urlFor } from '../../lib/sanity.js';

interface Foto {
  afbeelding: object;
  alt: string;
}

const fotos = await sanityClient.fetch<Foto[]>(`
  *[_type == "foto"] | order(datum desc) [0..3] {
    afbeelding,
    alt
  }
`);
---

<section class="galerij">
  <div class="galerij-content">

    <header class="galerij-header">
      <p class="galerij-label">recent werk ~</p>
      <h2 class="galerij-titel">Galerij</h2>
    </header>

    <ul class="galerij-grid">
      {fotos.map(({ afbeelding, alt }) => (
        <li class="galerij-item">
          <img
            src={urlFor(afbeelding).width(400).height(400).fit('crop').auto('format').quality(80).url()}
            alt={alt}
            width="400"
            height="400"
            loading="lazy"
          />
        </li>
      ))}
    </ul>

    <a href="/galerij" class="galerij-link">Alle foto's bekijken →</a>

  </div>
</section>

<style>
  .galerij {
    background-color: var(--color-main);
    padding-block: var(--space-8);
    padding-inline: var(--space-8);
  }

  .galerij-content {
    max-width: var(--container-max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
  }

  /* ── Header ── */
  .galerij-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .galerij-label {
    font-family: var(--font-secondary);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--color-text);
  }

  .galerij-titel {
    font-size: var(--font-size-heading-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-title);
    line-height: 1;
  }

  .galerij-titel::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background-color: var(--color-tertiary);
    margin: var(--space-4) auto 0;
  }

  /* ── Grid ── */
  .galerij-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    width: 100%;

    @media (min-width: 480px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (min-width: 800px) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .galerij-item {
    aspect-ratio: 1;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
  }

  .galerij-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .galerij-item:hover img {
    transform: scale(1.04);
  }

  /* ── Link ── */
  .galerij-link {
    font-size: var(--font-size-muted);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: var(--border-width) solid transparent;
    padding-bottom: var(--space-1);
    transition: color 0.2s ease, border-color 0.2s ease;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .galerij-link:hover {
    color: var(--color-title);
    border-bottom-color: var(--color-title);
  }
</style>

