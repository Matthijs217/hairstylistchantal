---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/diensten', label: 'Diensten' },
  { href: '/over', label: 'Over' },
  { href: '/galerij', label: 'Galerij' },
  { href: '/reviews', label: 'Reviews' },
  { href: '/contact', label: 'Contact' },
];
---

<header>
  <nav aria-label="Hoofdnavigatie">
    <ul class="nav-left">
      <li><a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a></li>
      <li><a href="/diensten" aria-current={currentPath === '/diensten' ? 'page' : undefined}>Diensten</a></li>
      <li><a href="/over" aria-current={currentPath === '/over' ? 'page' : undefined}>Over</a></li>
      <li><a href="/galerij" aria-current={currentPath === '/galerij' ? 'page' : undefined}>Galerij</a></li>
    </ul>

    <a href="/" class="logo" aria-label="Chantal Hairstyling, naar de homepage">
      <img src="/chantallogoklein.webp" alt="Chantal Hairstyling logo" class="logo-img" />
    </a>

    <ul class="nav-right">
      <li><a href="/reviews" aria-current={currentPath === '/reviews' ? 'page' : undefined}>Reviews</a></li>
      <li><a href="/contact" aria-current={currentPath === '/contact' ? 'page' : undefined}>Contact</a></li>
      <li>
        <a
          href="https://www.treatwell.nl/salon/hairstylist-chantal-oosterlaken/"
          class="btn-afspraak"
          data-treatwell-booking
          target="_blank"
          rel="noopener noreferrer"
        >Afspraak</a>
      </li>
    </ul>

    <details class="nav-mobile">
      <summary class="hamburger" aria-label="Menu openen">
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
      </summary>

      <div class="menu-panel">
        <ul class="menu-list">
          {navLinks.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={currentPath === href ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))}
        </ul>
        <a
          href="https://www.treatwell.nl/salon/hairstylist-chantal-oosterlaken/"
          class="btn-afspraak menu-cta"
          data-treatwell-booking
          target="_blank"
          rel="noopener noreferrer"
        >Afspraak</a>
      </div>
    </details>
  </nav>
</header>

<style>
  header {
    background-color: var(--color-secondary);
    border-bottom: var(--border-width) solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
    padding-inline: var(--space-8);
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-block: var(--space-2);
    gap: var(--space-8);

    & > ul {
      display: none;
    }

    @media (min-width: 800px) {
      justify-content: space-between;
      position: static;

      & > ul {
        display: flex;
      }
    }
  }

  ul {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    flex: 1;
  }

  .nav-right {
    justify-content: flex-end;
  }

  a {
    font-size: var(--font-size-muted);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: var(--border-width) solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  a:hover,
  a[aria-current="page"] {
    color: var(--color-title);
    border-bottom-color: var(--color-title);
  }

  /* ── Logo ── */
  .logo {
    display: flex;
    flex-shrink: 0;
    border-bottom: none;
  }

  .logo:hover {
    border-bottom: none;
  }

  .logo-img {
    height: 72px;
    width: auto;
    display: block;
  }

  /* ── Afspraak knop ── */
  .btn-afspraak {
    font-size: var(--font-size-muted);
    font-weight: var(--font-weight-medium);
    color: var(--color-white);
    background-color: var(--color-accent);
    padding: var(--space-2) var(--space-5);
    border-radius: 9999px;
    border-bottom: none;
    transition: opacity 0.2s ease;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .btn-afspraak:hover {
    opacity: 0.85;
    border-bottom: none;
    color: var(--color-white);
  }

  /* ── Mobile nav ── */
  .nav-mobile {
    display: block;
    position: absolute;
    right: var(--space-6);

    @media (min-width: 800px) {
      display: none;
    }
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    cursor: pointer;
    padding: var(--space-2);
    list-style: none;
    position: relative;
    z-index: 200;
  }

  .bar {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--color-title);
    transition: transform 0.25s ease, opacity 0.25s ease;
    transform-origin: center;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  details[open] .bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  details[open] .bar:nth-child(2) { opacity: 0; transform: scaleX(0); }
  details[open] .bar:nth-child(3) { transform: translateY(-5px) rotate(-45deg); }

  /* ── Menu panel ── */
  .menu-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 70%;
    z-index: 150;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-inline: var(--space-8);
    padding-block: var(--space-12);
    background-color: var(--color-secondary);
    border-left: var(--border-width) solid var(--color-border);
    @media (min-width: 440px) {
      width: 50%;
    }
  }

  .menu-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    flex: unset;
  }

  .menu-list a {
    font-size: var(--font-size-heading-s);
    letter-spacing: 0.15em;
    border-bottom-color: transparent;
  }

  .menu-list a:hover,
  .menu-list a[aria-current="page"] {
    border-bottom-color: var(--color-title);
  }

  .menu-cta {
    margin-top: auto;
    width: 100%;
    text-align: center;
    padding-block: var(--space-4);
  }

</style>

<script is:inline>
  const details = document.querySelector('.nav-mobile');

  document.querySelectorAll('.menu-list a, .menu-cta').forEach((link) => {
    link.addEventListener('click', () => {
      if (details) details.removeAttribute('open');
    });
  });

  details?.addEventListener('toggle', () => {
    if (details.open) {
      const firstLink = details.querySelector('.menu-list a');
      firstLink?.focus();
    }
  });

  // AI HULP
  details?.addEventListener('keydown', (e) => {
    if (!details.open || e.key !== 'Tab') return;

    const focusable = [...details.querySelectorAll('summary, a')];
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>