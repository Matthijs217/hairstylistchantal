---
import { sanityClient, urlFor } from '../../lib/sanity.js';

const diensten = await sanityClient.fetch<Dienst[]>(`
  *[_type == "dienst"] | order(volgorde asc) [0..2] {
    titel,
    beschrijving,
    "slug": slug.current,
    afbeelding,
    "afbeeldingAlt": afbeelding.alt
  }
`);
---

<section class="diensten">
  <div class="diensten-content">
    <header class="diensten-header">
      <p class="diensten-label">wat ik doe ~</p>
      <h2 class="diensten-titel">Diensten</h2>
    </header>

    <ul class="diensten-lijst">
      {diensten.map(({ slug, titel, beschrijving, afbeelding, afbeeldingAlt }) => (
        <li class="dienst-card">
          <div class="dienst-afbeelding">
            <img
              src={urlFor(afbeelding).width(600).height(300).fit('crop').auto('format').quality(80).url()}
              alt={afbeeldingAlt ?? titel}
              width="600"
              height="300"
              loading="lazy"
            />
          </div>
          <div class="dienst-tekst">
            <h3 class="dienst-naam">{titel}</h3>
            <p class="dienst-omschrijving">{beschrijving}</p>
            <a href={`/diensten`} class="dienst-link">Bekijk →</a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .diensten {
    background-color: var(--color-secondary);
    padding-block: var(--space-16);
    padding-inline: var(--space-8);
  }

  .diensten-content {
    max-width: var(--container-max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
  }

  /* ── Header ── */
  .diensten-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .diensten-label {
    font-family: var(--font-secondary);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--color-text);
  }

  .diensten-titel {
    font-size: var(--font-size-heading-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-title);
    line-height: 1;
  }

  .diensten-titel::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background-color: var(--color-tertiary);
    margin: var(--space-4) auto 0;
  }

  /* ── Grid ── */
  .diensten-lijst {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    width: 100%;

    @media (min-width: 800px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── Card ── */
  .dienst-card {
    display: flex;
    flex-direction: column;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    background-color: var(--color-secondary);
    transition: box-shadow 0.2s ease;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    @media (min-width: 480px) {
      flex-direction: row;
    }

    @media (min-width: 800px) {
      flex-direction: column;
    }
  }

  .dienst-card:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.07);
  }

  .dienst-afbeelding {
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;

    @media (min-width: 480px) {
      width: 140px;
      flex-shrink: 0;
      aspect-ratio: 1;
    }

    @media (min-width: 800px) {
      width: 100%;
      flex-shrink: unset;
      aspect-ratio: 2 / 1;
    }
  }

  .dienst-afbeelding img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .dienst-card:hover .dienst-afbeelding img {
    transform: scale(1.03);
  }

  .dienst-tekst {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);

    @media (min-width: 800px) {
      padding: var(--space-6);
    }
  }

  .dienst-naam {
    font-family: var(--font-tertiary);
    font-size: var(--font-size-heading-s);
    font-weight: var(--font-weight-regular);
    color: var(--color-title);
  }

  .dienst-omschrijving {
    font-size: var(--font-size-body);
    font-style: italic;
    color: var(--color-text);
  }

  .dienst-link {
    font-size: var(--font-size-muted);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    margin-top: var(--space-2);
    border-bottom: var(--border-width) solid transparent;
    padding-bottom: var(--space-1);
    align-self: flex-start;
    transition: color 0.2s ease, border-color 0.2s ease;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .dienst-link:hover {
    color: var(--color-title);
    border-bottom-color: var(--color-title);
  }
</style>
