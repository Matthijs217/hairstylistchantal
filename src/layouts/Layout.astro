---
import '../styles/typography.css';
import '../styles/stylesheet.css';
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Hairstylist Chantal Oosterlaken',
  description = 'Persoonlijke haarsalon in Broek in Waterland. Knippen, kleuren en stylen door Chantal. Maak eenvoudig een afspraak via Treatwell.',
} = Astro.props;

const pageTitle = title === 'Hairstylist Chantal' ? title : `${title} | Hairstylist Chantal`;
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/webp" sizes="192x192" href="/logo.webp" />
		<link rel="icon" type="image/webp" sizes="32x32" href="/logo.webp" />
		<link rel="apple-touch-icon" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="nl_NL" />
		<script src="https://widget.treatwell.nl/common/venue-menu/javascript/widget-button.js?v1" is:inline></script>
	</head>
	<body>
		<Header />
			<main>
				<slot />
			</main>
		<Footer />
		<a
			href="https://www.treatwell.nl/salon/hairstylist-chantal-oosterlaken/"
			class="btn-fab"
			data-treatwell-booking
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Maak een afspraak"
		>Afspraak</a>
		<script is:inline>
			document.querySelectorAll('[data-treatwell-booking]').forEach((btn) => {
				btn.addEventListener('click', (e) => {
					e.preventDefault();
					wahanda.openOnlineBookingWidget('https://widget.treatwell.nl/salon/523909/menu/');
				});
			});
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.btn-fab {
		position: fixed;
		bottom: var(--space-6);
		right: var(--space-6);
		z-index: 90;
		font-size: var(--font-size-body);
		font-weight: var(--font-weight-medium);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-white);
		background-color: var(--color-accent);
		padding: var(--space-3) var(--space-6);
		border-radius: 9999px;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
		transition: opacity 0.2s ease;
		white-space: nowrap;

		@media (prefers-reduced-motion: reduce) {
			transition: none;
		}

		@media (min-width: 800px) {
			display: none;
		}
	}

	.btn-fab:hover {
		opacity: 0.85;
	}
</style>
