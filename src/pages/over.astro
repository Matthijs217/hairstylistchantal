---
import Layout from '../layouts/Layout.astro';
import { sanityClient, urlFor } from '../lib/sanity.js';
import { Image } from 'astro:assets';
import salonImg from '../assets/salon.webp';

interface Waarde {
  titel: string;
  omschrijving: string;
}

interface OverData {
  naam: string;
  functie: string;
  foto: object | null;
  intro: string | null;
  bio: any[] | null;
  waarden: Waarde[] | null;
}

const data = await sanityClient.fetch<OverData | null>(`
  *[_type == "over" && _id == "over"][0] {
    naam, functie, foto, intro, bio, waarden
  }
`);

const naam      = data?.naam      ?? 'Chantal Oosterlaken';
const functie   = data?.functie   ?? 'Hairstylist';
const intro     = data?.intro     ?? 'Een rustige, persoonlijke salon waar jij centraal staat — voor jouw haar én een goed gesprek.';
const waarden   = data?.waarden   ?? [
  { titel: 'Persoonlijk',   omschrijving: 'Ik neem de tijd voor jou. Geen gehaast, maar echte aandacht voor jouw wensen en haartype.' },
  { titel: 'Vakmanschap',   omschrijving: 'Met jarenlange ervaring weet ik wat werkt. Van knippen tot kleur — altijd met zorg en precisie.' },
  { titel: 'Sfeer',         omschrijving: 'De salon staat op een prachtige plek in Broek in Waterland. Je komt hier helemaal tot rust.' },
];
---

<Layout
  title="Over mij"
  description={`Maak kennis met ${naam}, hairstylist in Broek in Waterland. Persoonlijke aandacht, vakmanschap en een rustgevende sfeer.`}
>

  <!-- ── Hero ── -->
  <section class="over-hero">
    <div class="over-hero-content">
      <p class="label">wie ben ik ~</p>
      <h1 class="titel">Over mij</h1>
    </div>
  </section>

  <!-- ── Intro ── -->
  <section class="over-intro">
    <div class="over-intro-content">
      <div class="intro-tekst">
        <p class="functie">{functie}</p>
        <h2 class="naam">{naam}</h2>
        <p class="intro-quote">"{intro}"</p>
        {data?.bio && (
          <div class="bio">
            {data.bio
              .filter((block: any) => block._type === 'block')
              .map((block: any) => (
                <p>{block.children?.map((c: any) => c.text).join('')}</p>
              ))
            }
          </div>
        )}
      </div>
      <div class="intro-foto">
        {data?.foto
          ? <img
              src={urlFor(data.foto).width(600).height(700).fit('crop').auto('format').quality(85).url()}
              alt={`Portretfoto van ${naam}`}
              width="600"
              height="700"
              loading="lazy"
            />
          : <Image
              src={salonImg}
              alt="De salon van Chantal Hairstyling"
              width={600}
              height={700}
              loading="lazy"
            />
        }
      </div>
    </div>
  </section>

  <!-- ── Kernwaarden ── -->
  <section class="waarden">
    <div class="waarden-content">
      <header class="waarden-header">
        <p class="label">waar ik voor sta ~</p>
        <h2 class="waarden-titel">Mijn aanpak</h2>
      </header>
      <ul class="waarden-grid">
        {waarden.map(({ titel, omschrijving }) => (
          <li class="waarde-card">
            <h3 class="waarde-naam">{titel}</h3>
            <p class="waarde-omschrijving">{omschrijving}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="cta">
    <div class="cta-content">
      <p class="label cta-label">tot snel ~</p>
      <h2 class="cta-titel">Maak een afspraak</h2>
      <p class="cta-sub">Direct online boeken via Treatwell</p>
      <a
        href="https://www.treatwell.nl/salon/hairstylist-chantal-oosterlaken/"
        class="btn-afspraak"
        data-treatwell-booking
        target="_blank"
        rel="noopener noreferrer"
      >Afspraak maken</a>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ── */
  .over-hero {
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
    padding-inline: var(--space-8);
  }

  .over-hero-content {
    max-width: var(--container-max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .label {
    font-family: var(--font-secondary);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--color-text);
  }

  .titel {
    font-size: var(--font-size-heading-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-title);
    line-height: 1;
  }

  .titel::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background-color: var(--color-tertiary);
    margin: var(--space-4) auto 0;
  }

  /* ── Intro ── */
  .over-intro {
    background-color: var(--color-main);
    padding-block: var(--space-16);
    padding-inline: var(--space-8);
  }

  .over-intro-content {
    max-width: var(--container-max-width);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: start;

    @media (min-width: 800px) {
      grid-template-columns: 1fr 420px;
      gap: var(--space-16);
    }

    @media (min-width: 1100px) {
      grid-template-columns: 1fr 520px;
    }
  }

  .intro-tekst {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);

    @media (min-width: 800px) {
      order: -1;
    }
  }

  .functie {
    font-size: var(--font-size-muted);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-tertiary);
  }

  .naam {
    font-size: var(--font-size-heading-l);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-title);
    line-height: 1.1;
    margin-top: calc(var(--space-2) * -1);
  }

  .intro-quote {
    font-family: var(--font-tertiary);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-style: italic;
    color: var(--color-text);
    line-height: 1.7;
    max-width: 52ch;
    padding-left: var(--space-6);
    border-left: 2px solid var(--color-tertiary);
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);

    & p {
      font-size: var(--font-size-body);
      color: var(--color-text);
      line-height: 1.8;
      max-width: 60ch;
    }
  }

  .intro-foto {
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  /* ── Waarden ── */
  .waarden {
    background-color: var(--color-secondary);
    padding-block: var(--space-24);
    padding-inline: var(--space-8);
    border-top: var(--border-width) solid var(--color-border);
  }

  .waarden-content {
    max-width: var(--container-max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .waarden-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .waarden-titel {
    font-size: var(--font-size-heading-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-title);
    line-height: 1;
  }

  .waarden-titel::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background-color: var(--color-tertiary);
    margin: var(--space-4) auto 0;
  }

  .waarden-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);

    @media (min-width: 640px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (min-width: 900px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .waarde-card {
    padding: var(--space-8);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius-lg);
    background-color: var(--color-main);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .waarde-naam {
    font-family: var(--font-tertiary);
    font-size: var(--font-size-heading-s);
    font-weight: var(--font-weight-regular);
    color: var(--color-title);
  }

  .waarde-omschrijving {
    font-size: var(--font-size-body);
    font-style: italic;
    color: var(--color-text);
    line-height: 1.7;
  }

  /* ── CTA ── */
  .cta {
    background-color: var(--color-main);
    padding-block: var(--space-24);
    padding-inline: var(--space-8);
    border-top: var(--border-width) solid var(--color-border);
  }

  .cta-content {
    max-width: var(--container-max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  .cta-label {
    margin-bottom: calc(var(--space-2) * -1);
  }

  .cta-titel {
    font-size: var(--font-size-heading-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-title);
    line-height: 1;
  }

  .cta-sub {
    font-size: var(--font-size-body);
    font-family: var(--font-tertiary);
    font-style: italic;
    color: var(--color-text);
  }

  .btn-afspraak {
    font-size: var(--font-size-muted);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-white);
    background-color: var(--color-accent);
    padding: var(--space-4) var(--space-12);
    border-radius: 9999px;
    margin-top: var(--space-4);
    transition: opacity 0.2s ease;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .btn-afspraak:hover {
    opacity: 0.85;
  }
</style>
