---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pagina niet gevonden" description="Deze pagina bestaat niet.">
  <section class="niet-gevonden">
    <div class="content">
      <p class="label">oeps ~</p>
      <h1 class="titel">404</h1>
      <p class="sub">Pagina niet gevonden</p>
      <p class="omschrijving">De pagina die je zoekt bestaat niet of is verplaatst.</p>
      <a href="/" class="btn-terug">← Terug naar home</a>
    </div>
  </section>
</Layout>

<style>
  .niet-gevonden {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100svh - 80px);
    padding-inline: var(--space-8);
    padding-block: var(--space-24);
    background-color: var(--color-main);
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  .label {
    font-family: var(--font-secondary);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--color-text);
    margin-bottom: calc(var(--space-2) * -1);
  }

  .titel {
    font-size: var(--font-size-display);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    color: var(--color-title);
    line-height: 1;
    opacity: 0.15;
  }

  .sub {
    font-size: var(--font-size-heading-l);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-title);
    line-height: 1;
    margin-top: calc(var(--space-16) * -1);
  }

  .omschrijving {
    font-size: var(--font-size-body);
    font-family: var(--font-tertiary);
    font-style: italic;
    color: var(--color-text);
    max-width: 40ch;
    margin-block: var(--space-2);
  }

  .btn-terug {
    font-size: var(--font-size-muted);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: var(--border-width) solid transparent;
    padding-bottom: var(--space-1);
    transition: color 0.2s ease, border-color 0.2s ease;
    margin-top: var(--space-4);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .btn-terug:hover {
    color: var(--color-title);
    border-bottom-color: var(--color-title);
  }
</style>
