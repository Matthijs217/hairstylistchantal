---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { sanityClient, urlFor } from '../lib/sanity.js';
import { fetchInstagramFotos, instaAlt } from '../lib/instagram.ts';

interface SanityFoto {
  afbeelding: object;
  alt: string;
  datum: string | null;
  _createdAt: string;
}

interface FotoItem {
  src: string;
  srcset: string;
  alt: string;
  datum: Date;
  href?: string;
  bron: 'cms' | 'instagram';
}

const [sanityFotos, instaFotos] = await Promise.all([
  sanityClient.fetch<SanityFoto[]>(`
    *[_type == "foto"] | order(coalesce(datum, _createdAt) desc) {
      afbeelding,
      alt,
      datum,
      _createdAt
    }
  `),
  fetchInstagramFotos(),
]);

const cmsFotos: FotoItem[] = sanityFotos.map((f) => ({
  src: urlFor(f.afbeelding).width(600).height(600).fit('crop').auto('format').quality(80).url(),
  srcset: [
    urlFor(f.afbeelding).width(300).height(300).fit('crop').auto('format').quality(80).url() + ' 300w',
    urlFor(f.afbeelding).width(600).height(600).fit('crop').auto('format').quality(80).url() + ' 600w',
  ].join(', '),
  alt: f.alt,
  datum: new Date(f.datum ?? f._createdAt),
  bron: 'cms',
}));

const instagramFotos: FotoItem[] = instaFotos.map((f) => ({
  src: f.media_url,
  srcset: '',
  alt: instaAlt(f.caption),
  datum: new Date(f.timestamp),
  href: f.permalink,
  bron: 'instagram',
}));

const alleFotos: FotoItem[] = [...cmsFotos, ...instagramFotos].sort(
  (a, b) => b.datum.getTime() - a.datum.getTime()
);

const BATCH = 12;
---

<Layout
  title="Galerij"
  description="Bekijk het werk van Hairstylist Chantal. Kapsels, kleur en stylingen uit de salon in Broek in Waterland."
>

  <section class="galerij-hero">
    <div class="galerij-hero-content">
      <p class="label">recent werk ~</p>
      <h1 class="titel">Galerij</h1>
    </div>
  </section>

  <section class="galerij">
    <div class="galerij-content">

      <a
        href="https://www.instagram.com/hairstylistchantal_/"
        class="insta-banner"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        Volg @hairstylistchantal_ op Instagram
      </a>

      <ul class="galerij-grid" id="galerij-grid">
        {alleFotos.map(({ src, srcset, alt, href, bron }, i) => (
          <li class="galerij-item" data-index={i} hidden={i >= BATCH || undefined}>
            {href ? (
              <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`${alt} (opent Instagram)`}>
                <img src={src} srcset={srcset} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw" alt={alt} width="600" height="600" loading={i < BATCH ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
                {bron === 'instagram' && (
                  <span class="insta-badge" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  </span>
                )}
              </a>
            ) : (
              <img src={src} srcset={srcset} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw" alt={alt} width="600" height="600" loading={i < BATCH ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
            )}
          </li>
        ))}
      </ul>

      {alleFotos.length > BATCH && (
        <div class="meer-wrapper" id="meer-wrapper">
          <button class="btn-meer" id="btn-meer" type="button">
            Meer laden
            <span class="teller" id="teller">({BATCH} / {alleFotos.length})</span>
          </button>
        </div>
      )}

    </div>
  </section>

</Layout>


<script is:inline>
  const BATCH = 12;
  const grid = document.getElementById('galerij-grid');
  const btn = document.getElementById('btn-meer');
  const teller = document.getElementById('teller');
  const wrapper = document.getElementById('meer-wrapper');

  if (grid && btn) {
    const items = [...grid.querySelectorAll('[data-index]')];
    const total = items.length;
    let shown = BATCH;

    btn.addEventListener('click', () => {
      const next = Math.min(shown + BATCH, total);
      for (let i = shown; i < next; i++) {
        items[i].removeAttribute('hidden');
      }
      shown = next;
      if (teller) teller.textContent = `(${shown} / ${total})`;
      if (shown >= total && wrapper) wrapper.remove();
    });
  }
</script>

<style>
  /* ── Hero ── */
  .galerij-hero {
    padding-block: var(--space-8);
    padding-inline: var(--space-8);
  }

  .galerij-hero-content {
    max-width: var(--container-max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .label {
    font-family: var(--font-secondary);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--color-text);
  }

  .titel {
    font-size: var(--font-size-heading-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-title);
    line-height: 1;
  }

  .titel::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background-color: var(--color-tertiary);
    margin: var(--space-4) auto 0;
  }

  /* ── Grid ── */
  .galerij {
    background-color: var(--color-main);
    padding-block: var(--space-4);
    padding-inline: var(--space-8);
  }

  .galerij-content {
    max-width: var(--container-max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .insta-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-size: var(--font-size-muted);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-tertiary);
    text-decoration: none;
    transition: color 0.2s ease;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .insta-banner:hover {
    color: var(--color-title);
  }

  .galerij-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);

    @media (min-width: 640px) {
      grid-template-columns: repeat(3, 1fr);
    }

    @media (min-width: 1024px) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .galerij-item {
    aspect-ratio: 1;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
  }

  .galerij-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .galerij-item:hover img {
    transform: scale(1.04);
  }

  /* ── Meer laden ── */
  .meer-wrapper {
    display: flex;
    justify-content: center;
  }

  .btn-meer {
    font-size: var(--font-size-muted);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-title);
    background: none;
    border: var(--border-width) solid var(--color-title);
    padding: var(--space-3) var(--space-8);
    border-radius: 9999px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
    display: flex;
    align-items: center;
    gap: var(--space-3);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .btn-meer:hover {
    background-color: var(--color-title);
    color: var(--color-white);
  }

  .teller {
    font-weight: var(--font-weight-regular);
    opacity: 0.6;
  }
</style>
